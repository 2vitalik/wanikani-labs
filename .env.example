# ---- WaniKani ---------------------------------------------------------------
# One token per account; the suffix after `WK_TOKEN__` is the account key
# (lower-cased). Keys `main`/`light` continue the 2022–2026 file history.
WK_TOKEN__MAIN=
WK_TOKEN__LIGHT=

# ---- Telegram ---------------------------------------------------------------
# Empty BOT_TOKEN = dry-run: digests go to the log instead of Telegram.
BOT_TOKEN=
# Supergroup with topics enabled; bot must be admin with "Manage topics".
TG_FORUM_CHAT_ID=
# Who may use /sync, /status … (comma-separated Telegram user ids).
TG_ADMIN_IDS=

# ---- Mongo ------------------------------------------------------------------
#MONGO_URI=mongodb://localhost:27017
#MONGO_DB=wanikani_labs

# ---- Optional overrides (defaults in packages/lib/src/wklabs/lib/settings.py) --------
#TZ=Europe/Kyiv
#SYNC_INTERVAL=300          # seconds between account polls
#SUBJECTS_INTERVAL=3600     # seconds between global (subjects, srs, voice actors) polls
#HEARTBEAT_TIME=09:00       # daily heartbeat to the `system` topic (local TZ); empty = off
#LOG_LEVEL=INFO
