# /srv/wanikani-labs/shared/env  (640 root:app-wanikani-labs) — systemd EnvironmentFile:
# no quotes, no expansion, no comments after values.
# WaniKani accounts are NOT here: they live in Mongo (bot /accounts or `wklabs accounts add`).
BOT_TOKEN=
TG_ADMIN_IDS=
# open (default) | approve | closed — who may use the bot (T21)
ACCESS_POLICY=open
# Fernet key for account tokens at rest: `wklabs gen-key`; keep a copy in 1Password
WKLABS_SECRET_KEY=
MONGO_URI=mongodb://wanikani_labs:PASSWORD@127.0.0.1:27017/wanikani_labs
MONGO_DB=wanikani_labs
TZ=Europe/Kyiv
SYNC_INTERVAL=300
SUBJECTS_INTERVAL=3600
LOG_LEVEL=INFO
